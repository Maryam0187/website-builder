# Postgres (required) — Railway: add Postgres plugin and copy DATABASE_URL
DATABASE_URL=postgresql://user:pass@localhost:5432/website_builder
# DATABASE_SSL=false

# Admin login (seeded on first run if no admin exists)
ADMIN_EMAIL=admin@technonaire.com
ADMIN_PASSWORD=changeme123

# Session signing secret
SESSION_SECRET=replace-with-a-long-random-string

# Public URL of this builder (invite + chat link emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Customer live sites: https://{random}.technonaire.site
# Point wildcard DNS *.technonaire.site at this app (Railway) and enable wildcard SSL.
SITE_HOST_ROOT=technonaire.site
NEXT_PUBLIC_SITE_HOST_ROOT=technonaire.site

# Technonaire marketing site URL
NEXT_PUBLIC_TECHNONAIRE_URL=https://technonaire.com

# DineOS product site (restaurant / cafe template section CTA)
NEXT_PUBLIC_DINEOS_URL=https://dineos.technonaire.com

# Same Calendly link used on Technonaire + DineOS ("Book a meeting")
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/technonaire/30min

# Resend (https://resend.com) — verify subdomain mail.technonaire.com (not root MX)
RESEND_API_KEY=
MAIL_FROM=Technonaire Easy Website <noreply@mail.technonaire.com>

# Railway uploads volume mount (optional; defaults to /data)
# RAILWAY_VOLUME_MOUNT_PATH=/data

# Stripe (Test mode / sandbox) — enables card Checkout on Profile packages
STRIPE_SECRET_KEY=sk_test_...
# Local webhooks: stripe listen --forward-to localhost:3000/api/billing/webhook
# Each time you restart `stripe listen`, copy the new whsec_… into STRIPE_WEBHOOK_SECRET and restart next dev.
# If this secret is stale, Stripe CLI still shows --> events but the app returns 400 and billing won't sync from webhooks
# (return URL sync-checkout still works when you land on /profile?checkout=success).
STRIPE_WEBHOOK_SECRET=whsec_...
