# Postgres (required) — Railway: add Postgres plugin and copy DATABASE_URL
DATABASE_URL=postgresql://user:pass@localhost:5432/website_builder
# DATABASE_SSL=false

# Admin login (seeded on first run if no admin exists)
ADMIN_EMAIL=admin@technonaire.com
ADMIN_PASSWORD=changeme123

# Session signing secret
SESSION_SECRET=replace-with-a-long-random-string

# Public URL of this builder (invite + chat link emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Technonaire marketing site URL
NEXT_PUBLIC_TECHNONAIRE_URL=https://technonaire.com

# Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=Technonaire Easy Website <onboarding@resend.dev>

# Railway uploads volume mount (optional; defaults to /data)
# RAILWAY_VOLUME_MOUNT_PATH=/data
